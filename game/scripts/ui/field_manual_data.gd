class_name FieldManualData
extends RefCounted
## The Field Manual's two books (FieldManual): the attackers' and the defenders', each in its own voice.
##
##   The Host     FM 1-01, the field manual the last human army left to the beasts that took up its tools: printed,
##                a plate (the video) and a chapter for every beast, the margins written in by the soldiers who used it.
##   The Garrison TM 30-90, the Keep's standing orders: typed on the bunker's own forms, an order for every post.
##
## A chapter: name, latin (the Host's beasts), role (one line), meta ([label, value]), about (a paragraph), clips
## ([clip id, caption]: the figures, played in turn), skills ({key, name, text, clip}: clip, optional, is the figure
## that shows it; the reference to it can be clicked), note (the Host's in pencil, the Garrison's typed).
## A clip id is a video in res://assets/tutorial/<id>.ogv, cut from the showcase videos in media/ (and the dev
## scenes' recordings) by tools/video/cut_tutorial_clips.py (tools/video/tutorial_clips.json).
##
## The numbers are the game's (unit_types.gd, defender_armory.gd and the defense scripts); keep them in step.

const CLIP_DIR := "res://assets/tutorial/"


static func book(attacker: bool) -> Dictionary:
	return HOST if attacker else GARRISON


static func clip_path(id: String) -> String:
	return CLIP_DIR + id + ".ogv"


