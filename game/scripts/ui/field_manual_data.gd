	"issue": "COPY No. 07 OF 40.  DISTRIBUTION: KEEP GARRISON ONLY.  Destroy by burning when superseded.",
	"stamp": "HOLD THE KEEP",
	"classification": "SECRET",
	"part": "The Garrison",
	"skills_heading": "Duties",
	"chapters": [
		{
			"name": "General Orders",
			"role": "The defence of the Keep",
			"meta": [["Hold", "25 minutes"], ["Lost if", "every air vent destroyed"], ["Pay", "30% of each kill"], ["Credits", "none at the start"]],
			"about": "The Keep is a mountain bunker with a fortified face to every side. The enemy wins by destroying every air vent on its roofs; hold for twenty-five minutes and the Keep stands. You begin with no credits. Every enemy killed pays thirty per cent of its cost. You fight from one post at a time; every post you are not on fights on alone.",
			"clips": [["def_overview", "South gun deck, every gun crewed."], ["rifle_view", "From a rifle post."]],
			"skills": [
				{"key": "1-9", "name": "Take a post", "text": "Rifleman, sentry gun or cannon. TAB takes the post with the most enemies near it."},
				{"key": "G", "name": "Gunner Squad", "text": "Five heavy gunners in the south spawn hall. No cost."},
				{"key": "B N M K J H", "name": "Requisition", "text": "AA Squad 350, Flame Squad 300, Infiltrators 280, Sniper 220, Fighter Jet 600, Hover Tank 450. Six on the roster at most."},
				{"key": "F1-F6", "name": "Roster", "text": "Take command of a requisitioned unit. CTRL+F1-F6 changes its standing order from where you are."},
				{"key": "C", "name": "Drones", "text": "Calls the freshest drone swarm to your post."},
				{"key": "Y  U", "name": "Garrison spawn", "text": "Y moves your spawn to the next face. U sends its soldiers to the BASE, guns first, or to the FIELD."},
			],
			"note": "Posts not under your command fight on. Do not abandon the whole line for one face.",
		},
		{
			"name": "Garrison Rifleman",
			"designation": "Cyber Orc Sentinel, Shadowline rifle",
			"role": "Post. The foot soldier of the Keep",
			"meta": [["Raised", "1 per face / 12 s"], ["Sight", "34 m"], ["Fires at", "30 m"], ["Cost", "none"]],
			"about": "Raised deep in the Keep all battle long. Left to himself he crews the guns first, then lines the gun decks, then marches out through the gates to hold a perimeter round the mountain. Riflemen hold the rifle posts on the decks, which you may take over at any time.",
			"clips": [["rifle_view", "Rifle post, south deck: lionesses sneaking up the field."], ["def_overview", "The garrison at the guns."], ["rifle_flash", "A flash grenade lands on the post."]],
			"skills": [
				{"key": "WASD", "name": "Move", "text": "SHIFT sprints, SPACE jumps.", "clip": "rifle_view"},
				{"key": "LMB  RMB", "name": "Fire and aim", "text": "R reloads.", "clip": "rifle_view"},
				{"key": "Y", "name": "Spawn face", "text": "Moves your spawn round the Keep. That face then raises two soldiers at a time.", "clip": "def_overview"},
				{"key": "U", "name": "Base or field", "text": "BASE sends new soldiers to the guns, then the decks, then the field. FIELD sends them straight out to the perimeter.", "clip": "def_overview"},
				{"key": "WARNING", "name": "Flash", "text": "A Kangaroo grenade blinds every post within 10 m that sees it, for 2 s.", "clip": "rifle_flash"},
			],
			"note": "A rifleman sees 34 m and no further. Anything beyond belongs to the guns.",
		},
		{
			"name": "Orbital Sentry Gun",
			"role": "Deck gun. Gatling",
			"meta": [["Post", "every bay, every deck"], ["Crew", "one soldier"], ["Key", "1-9"], ["Cost", "none"]],
			"about": "A gatling on a low platform over the parapet, one to each bay of the four gun decks. It fires on its own only with a soldier in its seat; you may take it over crewed or not. It cannot fire into the doorway directly beneath it.",
			"clips": [["sentry_gun", "Crewed, sweeping, firing. The barrels glow."]],
			"skills": [
				{"key": "LMB", "name": "Fire", "text": "The barrels spin up before the first round.", "clip": "sentry_gun"},
				{"key": "RMB", "name": "Zoom", "text": "Look closer down the gun."},
				{"key": "HEAT", "name": "Overheating", "text": "Hold the trigger too long and the gun stops. Fire in bursts.", "clip": "sentry_gun"},
				{"key": "CREW", "name": "Knocked out", "text": "The crew is freed. The gun returns when repaired, and must be crewed again."},
			],
			"note": "Glowing barrels mean the gun is being wasted.",
		},
		{
			"name": "Arctic Sentinel Cannon",
			"role": "Deck gun. The long gun of the Keep",
			"meta": [["Hit", "55, 80 yours"], ["Splash", "30 within 3 m"], ["Reload", "1.5 s, 0.9 yours"], ["Reach", "257 m"]],
			"about": "The heavy gun beside each sentry gun. Its shells burst where they land. A shell flies true for 30 m, then drops: raise the barrel for range. Ten degrees reaches 126 m; near forty-five, the longest shot, 257 m. Crews lay their own guns and lob a shell every 12 s at targets out to 110 m.",
			"clips": [["cannon", "Recoil, the case thrown, shells lobbed far out."]],
			"skills": [
				{"key": "LMB", "name": "Fire", "text": "One shell. The barrel drives back into the mantlet and runs out again.", "clip": "cannon"},
				{"key": "RMB", "name": "Zoom", "text": "Look closer down the gun."},
				{"key": "AIM HIGH", "name": "Range", "text": "Past 30 m the shell falls. Aim above far targets and lead the moving ones.", "clip": "cannon"},
			],
			"note": "Bison and mules out-range the rifles. They do not out-range this.",
		},
		{
			"name": "Roof Defences",
			"role": "Automatic. Sentinel Bastion and Sentinel Spire",
			"meta": [["Post", "the roofs, every bay"], ["Crew", "none"]],
			"about": "On the roofs, round the air vents, the Sentinel Bastions (flak) and the Sentinel Spires (missiles) run themselves. They take aircraft first, talons on their attack runs included. They never engage a transport helicopter on their own: that is for you.",
			"clips": [["bastion", "Sentinel Bastion: flak."], ["spire", "Sentinel Spire: missiles."]],
			"skills": [
				{"key": "AUTO", "name": "Flak", "text": "A shell every 0.42 s, bursting by its target. Aircraft first, then the ground at a quarter of the damage.", "clip": "bastion"},
				{"key": "AUTO", "name": "Missiles", "text": "The Spire searches, swings onto an aircraft and fires homing missiles from four cells, each reloaded 7 s later.", "clip": "spire"},
			],
			"note": "Bison shells reach the roof. Expect to lose these first.",
		},
		{
			"name": "Gunner Squad",
			"designation": "Five Heavy Gunners",
			"role": "Squad. Minigunners in heavy armour",
			"meta": [["Key", "G"], ["Cost", "none"], ["Post", "south spawn hall"], ["Losses", "1 back every 20 s"]],
			"about": "Five minigunners in heavy armour. You drive the trooper in the middle; the other four follow and fire where you aim. The squad takes its own formation: a wedge in the open, pairs or single file in tight places. Blast doors open for it. Left alone it returns to its post.",
			"clips": [["gunner_fight", "A fight on two fronts."], ["gunner_file", "Single file up the spawn ramp."], ["gunner_wedge", "Out of the gate into a wedge."], ["gunner_solo", "One heavy gunner."]],
			"skills": [
				{"key": "WASD", "name": "Move", "text": "Relative to the camera. The troopers keep facing the aim.", "clip": "gunner_solo"},
				{"key": "LMB", "name": "Miniguns", "text": "Spin up, then all five fire. They overheat after about 7 s.", "clip": "gunner_fight"},
				{"key": "RMB", "name": "Close aim", "text": "Brings the camera in over the guns."},
				{"key": "SHIFT", "name": "Hustle", "text": "Faster, no firing."},
				{"key": "AUTO", "name": "Formation", "text": "Wedge, pairs or file, chosen for you before every narrow place.", "clip": "gunner_file"},
				{"key": "AUTO", "name": "Succession", "text": "Your trooper falls: the nearest takes the lead. All five lost: the squad is back in 30 s.", "clip": "gunner_wedge"},
			],
			"note": "Free, and back in 30 s. Spend it.",
		},
		{
			"name": "AA Squad",
			"designation": "Five Missile Troopers",
			"role": "Squad. Anti-aircraft, rockets, mines",
			"meta": [["Key", "B"], ["Cost", "350"], ["Pods", "6 missiles each"], ["Lost", "when all five fall"]],
			"about": "Armoured Sentinels with a six-missile pod on the shoulder: the garrison's answer to talons and transport helicopters, with rockets and mines for the ground. It deploys in a gate hall and joins the roster.",
			"clips": [["aa_lock", "Locked on: seeking missiles."], ["aa_strike", "A rocket strike."], ["aa_mines", "Mines, and the price of walking into them."], ["aa_auto", "Squads on their standing orders."]],
			"skills": [
				{"key": "RMB, LMB", "name": "Seeking missiles", "text": "Hold RMB near an aircraft for 3 s to lock. LMB fires as many as the kill needs.", "clip": "aa_lock"},
				{"key": "LMB", "name": "Rocket strike", "text": "Three rockets per trooper round the aim, 60 within 4.5 m each.", "clip": "aa_strike"},
				{"key": "F", "name": "Mines", "text": "Two per trooper, 160 within 4 m, invisible to the enemy. Again after 15 s.", "clip": "aa_mines"},
				{"key": "RELOAD", "name": "Pods", "text": "Tubes reload one at a time, 2.5 s each."},
				{"key": "V", "name": "Standing order", "text": "MINES lays fields on the way home and round the gates; GUARD holds. Both shoot down aircraft within 85 m.", "clip": "aa_auto"},
			],
			"note": "Only the wolves find the mines. Kill the wolves.",
		},
		{
			"name": "Flame Squad",
			"designation": "Five Flame Troopers",
			"role": "Squad. Burns the enemy and the forest",
			"meta": [["Key", "N"], ["Cost", "300"], ["Flame", "90 a second, 6 m"], ["Lost", "when all five fall"]],
			"about": "Crimson Wardens with twin fuel tanks. They burn the enemy at close range and burn the forest down, taking away the cover the chimpanzees, serpents and lionesses depend on. A burnt forest never grows back.",
			"clips": [["flame_fight", "Chimpanzees rush the squad out of the trees."], ["flame_tree", "The flame held on a trunk."], ["flame_clear", "Standing order CLEAR."], ["flame_solo", "One flame trooper."]],
			"skills": [
				{"key": "LMB", "name": "Flame", "text": "Ninety a second, and burning 2.5 s after. Fourteen seconds of pressure; it recovers when you let go.", "clip": "flame_fight"},
				{"key": "LMB", "name": "Burn a tree", "text": "Hold the flame on a trunk for 8 s. The tree falls 30 s later and the way is clear.", "clip": "flame_tree"},
				{"key": "V", "name": "Standing order", "text": "CLEAR burns the forests round the Keep, nearest first; GUARD holds. Enemies within 16 m come first.", "clip": "flame_clear"},
			],
			"note": "Burn the trees between the citadel and the gates early. The chimpanzees come through them.",
		},
		{
			"name": "Infiltrator Squad",
			"designation": "Five Infiltrators",
			"role": "Squad. Ambush and sabotage",
			"meta": [["Key", "M"], ["Cost", "280"], ["Arrow", "34, silent"], ["Lost", "when all five fall"]],
			"about": "Harpy Vanguards with recurve bows. The enemy never targets an infiltrator of its own accord; only an attack its commander orders will. Their work is the Forward Helipads, the outposts the enemy's helicopters fly to.",
			"clips": [["inf_bow", "Ignored by the riflemen she is shooting."], ["inf_camo", "Camouflage on."], ["inf_sabotage", "Sabotage on a helipad deck."], ["inf_op", "An operation, from above."]],
			"skills": [
				{"key": "PASSIVE", "name": "Low profile", "text": "Ignored unless ordered against. A Giraffe's ping that catches one without camouflage exposes her.", "clip": "inf_bow"},
				{"key": "LMB", "name": "Arrows", "text": "Thirty-four each. No tracer, no flash.", "clip": "inf_bow"},
				{"key": "Q", "name": "Camouflage", "text": "Twenty seconds, ready a minute later. The first arrow breaks it. Blasts still hurt.", "clip": "inf_camo"},
				{"key": "F", "name": "Sabotage", "text": "45 s within 4 m of a helipad deck. One kit; restock inside the Keep.", "clip": "inf_sabotage"},
				{"key": "V", "name": "Operation", "text": "OP S, E or W: out by the safest way, sabotage, home again. HOLD stays put.", "clip": "inf_op"},
			],
			"note": "Take a helipad while a helicopter sits on it.",
		},
		{
			"name": "Sniper",
			"designation": "The Grey Veil Warden, Eclipse Longshot",
			"role": "Marksman. Tags what she hits",
			"meta": [["Key", "K"], ["Cost", "220"], ["Health", "300"], ["Round", "140, to 400 m"]],
			"about": "One marksman in a ghillie cape. Her rounds tag what they hit, and the whole garrison hits a tagged enemy harder. Left alone she holds where you left her and picks off one enemy at a time within 160 m, never one inside a forest.",
			"clips": [["sniper_scope", "Through the scope: shot, bolt, reload."], ["sniper_tags", "Tagged, as the enemy sees it."], ["sniper_thermal", "Thermal sight through the trees."], ["sniper_walk", "Over her shoulder."]],
			"skills": [
				{"key": "RMB", "name": "Scope", "text": "Eight power; the wheel steps 4, 8 and 12.", "clip": "sniper_scope"},
				{"key": "LMB  R", "name": "Fire", "text": "140, then 1.5 s on the bolt. Five rounds; R reloads in 2.8 s.", "clip": "sniper_scope"},
				{"key": "PASSIVE", "name": "Tag", "text": "Twenty seconds: every defender hits it 20% harder, and a tagged Lioness cannot sneak. Five tags at most.", "clip": "sniper_tags"},
				{"key": "T", "name": "Thermal", "text": "Fifteen seconds, then a minute to recharge. The enemy glows; the trees turn to glass.", "clip": "sniper_thermal"},
			],
			"note": "Tag the elephants. The jet will thank you.",
		},
		{
			"name": "Fighter Jet",
			"role": "Machine. Chase camera",
			"meta": [["Key", "J"], ["Cost", "600"], ["Health", "700"], ["Speed", "120 m/s, 200 boosted"]],
			"about": "Scrambled into the air before a gate. It never lands. Fly it into the ground, the canopy, the mountain or a structure and it is lost for good. Elephant flak and rhinos fire on it. Left alone it circles where you left it and attacks only when attacked.",
			"clips": [["jet", "The fighter jet on the proving ground."]],
			"skills": [
				{"key": "MOUSE", "name": "Fly", "text": "Steer for the ring. W and S pitch, A and D turn.", "clip": "jet"},
				{"key": "SHIFT  SPACE", "name": "Boost and brake", "text": "200 m/s for 4 s; the airbrake holds 85."},
				{"key": "LMB", "name": "Bomb", "text": "Four carried, one back every 25 s: 220 within 6 m. The ring on the ground marks the fall."},
				{"key": "RMB", "name": "Missiles", "text": "Sixteen, unguided, 30 each. Eleven seconds to reload."},
				{"key": "WARNING", "name": "Pull up", "text": "Flashes before a collision. Past the edge of the field you have 7 s to turn back."},
			],
			"note": "It does not land. Ever. Watch for PULL UP.",
		},
		{
			"name": "Hover Tank",
			"designation": "The Iron Vanguard",
			"role": "Machine. Rides on air",
			"meta": [["Key", "H"], ["Cost", "450"], ["Health", "1,100"], ["Speed", "15 m/s"]],
			"about": "A hover tank, deployed outside a gate. It skims the rivers and the lake as easily as the ground, but it is broad: trees, rocks and walls stop it. Left alone it holds and fights whatever comes within 110 m.",
			"clips": [["hover_tank", "The Iron Vanguard on the proving ground."]],
			"skills": [
				{"key": "WASD", "name": "Drive", "text": "The turret follows the crosshair.", "clip": "hover_tank"},
				{"key": "LMB", "name": "Main gun", "text": "220 within 7 m, 3.2 s to reload. Fires only when laid. Straight for 200 m, then it drops."},
				{"key": "RMB", "name": "Machine guns", "text": "Fixed forward: aim them with the hull."},
				{"key": "SPACE", "name": "Jump", "text": "Twelve metres up and fifty-five on. Again after 10 s."},
				{"key": "CAUTION", "name": "Trees", "text": "A tree stops it dead: 45 to 95 damage and a short stun."},
			],
			"note": "Water is a road for this one. Use the rivers.",
		},
		{
			"name": "Drone Swarms",
			"role": "Support. Six swarms of five",
			"meta": [["Key", "C"], ["Reach", "155 m, full tank"], ["Hunt", "25 s within 80 m"]],
			"about": "Small gunships docked on the roofs. Any defender can call a swarm to where it stands: you with C, and the posts, squads and soldiers on their own when the enemy comes within 40 m. Each call takes the freshest swarm that can make the trip. Only anti-aircraft and bears can touch a drone.",
			"clips": [["drone_swarm", "A swarm off the roof onto a knot of the enemy."], ["drone", "A drone on the proving ground."]],
			"skills": [
				{"key": "C", "name": "Call a swarm", "text": "To your post. The panel shows the drones ready; a refused call says why.", "clip": "drone_swarm"},
				{"key": "FUEL", "name": "Recharge", "text": "Drones fly home to their docks. Below 65% a swarm cannot go far."},
			],
			"note": "Bears drop everything for a drone. Use that.",
		},
	],
}
